<nav class="navbar navbar-expand-lg sticky-top site-nav">

    <div class="container-fluid">

        <a class="navbar-brand" href="/listings">
            <i class="fa-solid fa-compass"></i>
            <span>StayEase</span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div
            class="collapse navbar-collapse"
            id="navbarNavAltMarkup"
        >

            <div class="navbar-nav">

                <a class="nav-link" href="/listings">
                    Explore
                </a>

            </div>

            <div class="navbar-nav ms-auto">

                <form
                    class="nav-search"
                    role="search"
                    action="/listings"
                    method="GET"
                >

                    <input
                        class="form-control me-2 search-input"
                        type="search"
                        placeholder="Search destinations"
                        name="location"
                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                    >

                    <input
                        class="date-input"
                        type="date"
                        name="checkin"
                        aria-label="Check in"
                        value="<%= typeof searchDates !== 'undefined' ? searchDates.checkin : '' %>"
                    >

                    <input
                        class="date-input"
                        type="date"
                        name="checkout"
                        aria-label="Check out"
                        value="<%= typeof searchDates !== 'undefined' ? searchDates.checkout : '' %>"
                    >

                    <select
                        class="guest-input"
                        name="guests"
                        aria-label="Guests"
                    >

                        <option value="">
                            Guests
                        </option>

                        <% [1,2,3,4,5,6,7,8].forEach(number => { %>

                            <option
                                value="<%= number %>"
                                <%= typeof searchDates !== 'undefined' &&
                                    String(searchDates.guests) === String(number)
                                    ? 'selected'
                                    : '' %>
                            >
                                <%= number %> guest<%= number > 1 ? 's' : '' %>
                            </option>

                        <% }) %>

                    </select>

                    <button
                        class="btn search-btn"
                        type="submit"
                    >
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Search</span>
                    </button>

                </form>

            </div>

            <div class="navbar-nav ms-auto">

                <a
                    class="nav-link host-link"
                    href="/listings/new"
                >
                    <i class="fa-solid fa-plus"></i>
                    List your home
                </a>

                <% if(!currentUser){ %>

                    <a class="nav-link" href="/signup">
                        Sign Up
                    </a>

                    <a class="btn account-btn" href="/login">
                        Login
                    </a>

                <% } else { %>

                    <a class="nav-link" href="/listings/mine">
                        My listings
                    </a>

                    <a class="btn account-btn" href="/logout">
                        Logout
                    </a>

                <% } %>

            </div>

        </div>

    </div>

</nav>