<% layout("/layouts/boilerplate") %>

<main class="listing-detail">

    <section class="detail-header">
        <div>
            <p class="eyebrow">
                <%= listing.category || "Trending" %>
            </p>

            <h1><%= listing.title %></h1>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %> ·
                <i class="fa-solid fa-star"></i>
                <%= listing.averageRating || "New" %>
                <%= listing.reviewCount ? ` (${listing.reviewCount} reviews)` : '' %>
            </p>
        </div>

        <% if(currentUser && listing.author && listing.author.equals(currentUser._id)){ %>
            <div class="detail-actions">

                <a href="/listings/<%= listing._id %>/edit" class="btn secondary-btn">
                    <i class="fa-solid fa-pen"></i> Edit
                </a>

                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn danger-btn">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                </form>

            </div>
        <% } %>
    </section>

    <section class="detail-layout">

        <div class="detail-main">

            <article class="show-card">

                <div class="gallery-grid">

                    <% const gallery = listing.images && listing.images.length ? listing.images : [listing.image]; %>

                    <% gallery.slice(0, 5).forEach((image, index) => { %>

                        <img
                            src="<%= image.url %>"
                            class="show-img gallery-image gallery-image-<%= index %>"
                            alt="<%= listing.title %> image <%= index + 1 %>"
                        >

                    <% }) %>

                </div>

                <div class="detail-copy">
                    <h2>About this stay</h2>
                    <p><%= listing.description %></p>
                </div>

            </article>

            <% if(listing.author) { %>

                <section class="host-profile">

                    <div class="host-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <h2>Hosted by <%= listing.author.username %></h2>

                        <p>
                            Host since
                            <%= new Date(listing.author.createdAt).getFullYear() %>
                            ·
                            <%= hostListingCount %>
                            <%= hostListingCount === 1 ? 'listing' : 'listings' %>
                        </p>
                    </div>

                </section>

            <% } %>

            <section class="map-section">
                <h2>
                    <i class="fa-solid fa-location-dot"></i>
                    Where you'll be
                </h2>

                <div id="map"></div>
            </section>

            <section class="reviews-section" id="reviews">

                <% if(currentUser){ %>

                    <div class="review-form">

                        <h2>Leave a review</h2>

                        <form
                            action="/listings/<%= listing._id %>/reviews"
                            method="POST"
                            novalidate
                            class="needs-validation"
                        >

                            <div class="mb-3">

                                <fieldset class="starability-slot">

                                    <input
                                        type="radio"
                                        id="no-rate"
                                        class="input-no-rate"
                                        name="review[rating]"
                                        value="0"
                                        checked
                                    >

                                    <input type="radio" id="first-rate1" name="review[rating]" value="1">
                                    <label for="first-rate1">1 star</label>

                                    <input type="radio" id="first-rate2" name="review[rating]" value="2">
                                    <label for="first-rate2">2 stars</label>

                                    <input type="radio" id="first-rate3" name="review[rating]" value="3">
                                    <label for="first-rate3">3 stars</label>

                                    <input type="radio" id="first-rate4" name="review[rating]" value="4">
                                    <label for="first-rate4">4 stars</label>

                                    <input type="radio" id="first-rate5" name="review[rating]" value="5">
                                    <label for="first-rate5">5 stars</label>

                                </fieldset>

                            </div>

                            <textarea
                                name="review[comment]"
                                rows="4"
                                class="form-control"
                                placeholder="What did you enjoy about this stay?"
                                required
                            ></textarea>

                            <button class="btn primary-btn mt-3">
                                Post review
                            </button>

                        </form>

                    </div>

                <% } %>

                <h2>Guest reviews</h2>

                <div class="row">

                    <% for(let review of listing.reviews){ %>

                        <article class="review-card col-md-5 m-2">

                            <h3>@<%= review.author.username %></h3>

                            <p
                                class="starability-result"
                                data-rating="<%= review.rating %>"
                            ></p>

                            <p><%= review.comment %></p>

                            <% if(currentUser && review.author._id.equals(currentUser._id)){ %>

                                <form
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >
                                    <button class="btn btn-sm danger-btn">
                                        Delete review
                                    </button>
                                </form>

                            <% } %>

                        </article>

                    <% } %>

                </div>

            </section>

        </div>

        <aside class="booking-card">

            <form action="/listings/<%= listing._id %>/save" method="POST">

                <button class="save-detail">
                    <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                    <%= isSaved ? 'Saved' : 'Save' %>
                </button>

            </form>

            <span>From</span>

            <strong>
                ₹<%= listing.price.toLocaleString("en-IN") %>
                <small>/ night</small>
            </strong>

            <hr>

            <p>
                <i class="fa-solid fa-shield-heart"></i>
                Your stay starts with a warm welcome.
            </p>

            <a href="#reviews" class="btn primary-btn">
                View reviews
            </a>

        </aside>

    </section>

</main>

<% if(listing.geometry && listing.geometry.coordinates){ %>

<script>

    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;

    const map = L.map("map").setView(
        [coordinates[1], coordinates[0]],
        13
    );

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            attribution: "&copy; OpenStreetMap contributors"
        }
    ).addTo(map);

    L.marker([coordinates[1], coordinates[0]])
        .addTo(map)
        .bindPopup(
            <%- JSON.stringify(
                `<b>${listing.title}</b><br>${listing.location}, ${listing.country}`
            ) %>
        )
        .openPopup();

</script>

<% } %>