<% layout("/layouts/boilerplate") %>

<section class="form-shell">

    <div class="form-intro">

        <p class="eyebrow">
            HOST WITH STAYEASE
        </p>

        <h1>
            Share your space with the world.
        </h1>

        <p>
            Give travellers the details they need to find and love your place.
        </p>

    </div>

    <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation listing-form"
        enctype="multipart/form-data"
    >

        <div class="form-section">

            <h2>About your place</h2>

            <div class="mb-3">

                <label for="title" class="form-label">
                    Listing title
                </label>

                <input
                    id="title"
                    type="text"
                    name="listing[title]"
                    placeholder="e.g. Calm cottage near the hills"
                    class="form-control"
                    required
                />

                <div class="invalid-feedback">
                    Please add a title.
                </div>

            </div>

            <div class="mb-3">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    id="description"
                    name="listing[description]"
                    placeholder="Tell guests what makes your place special..."
                    class="form-control"
                    rows="5"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please add a short description.
                </div>

            </div>

            <div class="mb-0">

                <label for="images" class="form-label">
                    Listing images
                </label>

                <input
                    id="images"
                    type="file"
                    name="listing[images]"
                    class="form-control"
                    accept="image/*"
                    multiple
                    required
                />

                <div class="form-hint">
                    Add up to five bright, clear photos. The first one becomes the cover image.
                </div>

            </div>

        </div>

        <div class="form-section">

            <h2>Location &amp; Price</h2>

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="price" class="form-label">
                        Price per night (₹)
                    </label>

                    <input
                        id="price"
                        type="number"
                        min="1"
                        name="listing[price]"
                        placeholder="2500"
                        class="form-control"
                        required
                    />

                </div>

                <div class="col-md-6">

                    <label for="category" class="form-label">
                        Category
                    </label>

                    <select
                        id="category"
                        name="listing[category]"
                        class="form-select"
                    >
                        <option>Trending</option>
                        <option>Rooms</option>
                        <option>Iconic Cities</option>
                        <option>Mountain</option>
                        <option>Castles</option>
                        <option>Amazing Pools</option>
                        <option>Camping</option>
                        <option>Farms</option>
                        <option>Arctic</option>
                        <option>Domes</option>
                        <option>Boats</option>
                    </select>

                </div>

                <div class="col-md-6">

                    <label for="location" class="form-label">
                        City or area
                    </label>

                    <input
                        id="location"
                        type="text"
                        name="listing[location]"
                        placeholder="e.g. Manali"
                        class="form-control"
                        required
                    />

                </div>

                <div class="col-md-6">

                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        id="country"
                        type="text"
                        name="listing[country]"
                        placeholder="e.g. India"
                        class="form-control"
                        required
                    />

                </div>

            </div>

        </div>

        <div class="form-actions">

            <a href="/listings" class="btn secondary-btn">
                Cancel
            </a>

            <button class="btn primary-btn">
                Publish listing
                <i class="fa-solid fa-arrow-right"></i>
            </button>

        </div>

    </form>

</section>